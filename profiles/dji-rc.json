    "driving_folders": [
      {
        "importable": true,
        "mode": "live_view_cache",
        "notes": [
          "Live-view OcuSync transmission caches recorded during drone flight. These are low-quality previews (~480p), not full-resolution drone footage. One MP4 file per continuous live-view session."
        ],
        "path": "Android/data/dji.go.v5/files/MediaCaches",
        "validation": "real_card_sampled"
      },
      {
        "importable": true,
        "mode": "transferred_drone_video",
        "notes": [
          "Drone footage transferred from the drone to the RC via the DJI Fly app. Empty on the sampled card \u2014 transfer must be explicitly triggered by the user in-app. When populated, files should match the DJI_NNNN.MP4 pattern from the drone card."
        ],
        "path": "Android/data/dji.go.v5/files/OriginalFiles/Video",
        "validation": "real_card_sampled"
      },
      {
        "importable": true,
        "mode": "transferred_drone_photo",
